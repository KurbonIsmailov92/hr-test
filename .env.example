APP_NAME="HR Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_DAILY_DAYS=30
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=hrms
DB_USERNAME=hrms
# Генерируется setup.sh. Не коммитить реальные значения.
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@hrms.local
MAIL_FROM_NAME="${APP_NAME}"

# Бизнес-настройки (см. config/hrms.php)
HRMS_DISPLAY_TIMEZONE=Asia/Dushanbe
HRMS_CONSENT_VERSION=draft-0

# Только для local/demo. Если пусто, сидер сгенерирует случайный пароль и покажет его в консоли.
SEED_DEMO_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# Для Docker на Linux (права на файлы). setup.sh подставляет их автоматически.
HOST_UID=1000
HOST_GID=1000
